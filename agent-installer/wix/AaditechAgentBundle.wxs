<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aaditech Agent Bundle (spec §7.2)

  Chains the three vendor agent MSIs into a single branded installer using
  WiX Burn (wix.exe build with the Bundle extension), so GPO/Intune pushes
  ONE file and all three components install and self-register silently,
  with no manual per-tool configuration on the endpoint.

  Build: wix build AaditechAgentBundle.wxs -ext WixToolset.Bal.wixext -o Aaditech-Agent-Setup.exe

  MSI properties (enrollment key, manager IP, etc.) are passed via
  MsiProperty elements below, sourced from the same values already
  generated by infra/generate-secrets.sh — this file does not hardcode
  any credential; -define switches at build time supply them, or a wrapped
  PSADT script (see ../psadt/Deploy-AaditechAgent.ps1) can inject them from
  its own config source at deploy time instead.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <Bundle Name="Aaditech Agent"
          Version="!(bind.FileVersion.WazuhAgentMsi)"
          Manufacturer="Aaditech"
          UpgradeCode="{b06067a6-6ed7-48a1-938b-da2c478f5157}">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        LicenseUrl=""
        LogoFile="branding\aaditech-logo.png"
        SuppressOptionsUI="yes"
        ShowVersion="yes" />
    </BootstrapperApplication>

    <!-- Silent by default — GPO/Intune push is the primary install path,
         not an engineer clicking through a wizard (spec §7.2). -->
    <Variable Name="InstallSilently" Type="numeric" Value="1" bal:Overridable="yes" />

    <!-- Values every agent needs — supplied at build/deploy time, never
         hardcoded. Matches infra/generate-secrets.sh output names. -->
    <Variable Name="ManagerIp"       Type="string" bal:Overridable="yes" />
    <Variable Name="WazuhEnrollKey"  Type="string" bal:Overridable="yes" />
    <Variable Name="ZabbixServerIp"  Type="string" bal:Overridable="yes" />
    <Variable Name="MeshCentralUrl"  Type="string" bal:Overridable="yes" />

    <Chain>
      <!-- 1. Wazuh agent — security/FIM/CVE endpoint component -->
      <MsiPackage Id="WazuhAgentMsi"
                  SourceFile="vendor\wazuh-agent.msi"
                  DisplayName="Wazuh Agent"
                  Vital="yes"
                  Permanent="no">
        <MsiProperty Name="WAZUH_MANAGER" Value="[ManagerIp]" />
        <MsiProperty Name="WAZUH_REGISTRATION_SERVER" Value="[ManagerIp]" />
        <MsiProperty Name="WAZUH_REGISTRATION_PASSWORD" Value="[WazuhEnrollKey]" />
      </MsiPackage>

      <!-- 2. Zabbix agent — infra/network performance component -->
      <MsiPackage Id="ZabbixAgentMsi"
                  SourceFile="vendor\zabbix-agent.msi"
                  DisplayName="Zabbix Agent"
                  Vital="yes"
                  Permanent="no">
        <MsiProperty Name="SERVER" Value="[ZabbixServerIp]" />
        <MsiProperty Name="SERVERACTIVE" Value="[ZabbixServerIp]" />
      </MsiPackage>

      <!-- 3. MeshCentral agent — remote access component -->
      <MsiPackage Id="MeshCentralAgentMsi"
                  SourceFile="vendor\meshcentral-agent.msi"
                  DisplayName="MeshCentral Agent"
                  Vital="yes"
                  Permanent="no">
        <MsiProperty Name="MESHURL" Value="[MeshCentralUrl]" />
      </MsiPackage>
    </Chain>

  </Bundle>
</Wix>
